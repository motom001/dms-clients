{
  "id": "app.ablago.clients.homey",
  "version": "1.1.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": ["local"],
  "name": {
    "en": "Ablago",
    "de": "Ablago"
  },
  "description": {
    "en": "New mail, to-dos and due dates from Ablago, your self-hosted document filing",
    "de": "Neue Post, Aufgaben und Fälliges aus Ablago, deiner selbst gehosteten Dokumentenablage"
  },
  "category": ["tools"],
  "tags": {
    "en": ["Ablago", "DMS", "document management", "mail", "letters", "due dates", "to-do", "paperless"],
    "de": ["Ablago", "DMS", "Dokumentenablage", "Dokumentenmanagement", "Post", "Briefe", "Fristen", "Aufgaben", "papierlos"]
  },
  "permissions": [],
  "brandColor": "#1F4E79",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Thomas Meissner"
  },
  "source": "https://github.com/motom001/dms-clients",
  "homepage": "https://help.ablago.app/benutzer/aktuell/hausautomatisierung/",
  "support": "https://github.com/motom001/dms-clients/issues",
  "bugs": {
    "url": "https://github.com/motom001/dms-clients/issues"
  },
  "capabilities": {
    "dms_neue_post": {
      "type": "number",
      "title": { "en": "New mail", "de": "Neue Post" },
      "desc": { "en": "Mail in the state Neu (new), for you or for everyone", "de": "Post im Stand Neu, für dich oder für alle" },
      "getable": true,
      "setable": false,
      "decimals": 0,
      "min": 0,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/neue_post.svg"
    },
    "dms_zu_erledigen": {
      "type": "number",
      "title": { "en": "To do", "de": "Zu erledigen" },
      "desc": { "en": "Folders with open tasks for you, as in To do", "de": "Mappen mit offenen Aufgaben für dich, wie unter Zu erledigen" },
      "getable": true,
      "setable": false,
      "decimals": 0,
      "min": 0,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/zu_erledigen.svg"
    },
    "dms_faellig_7_tage": {
      "type": "number",
      "title": { "en": "Due in 7 days", "de": "Fällig in 7 Tagen" },
      "desc": {
        "en": "Deadlines, reminders and tasks with a date from today to 7 days ahead",
        "de": "Fristen, Erinnerungen und Aufgaben mit Datum von heute bis in 7 Tagen"
      },
      "getable": true,
      "setable": false,
      "decimals": 0,
      "min": 0,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/faellig.svg"
    },
    "dms_ueberfaellig": {
      "type": "number",
      "title": { "en": "Overdue", "de": "Überfällig" },
      "desc": { "en": "Open deadlines, reminders and tasks dated before today", "de": "Offene Fristen, Erinnerungen und Aufgaben mit Datum vor heute" },
      "getable": true,
      "setable": false,
      "decimals": 0,
      "min": 0,
      "uiComponent": "sensor",
      "insights": true,
      "icon": "/assets/capabilities/ueberfaellig.svg"
    }
  },
  "drivers": [
    {
      "id": "dms",
      "name": { "en": "Ablago", "de": "Ablago" },
      "class": "sensor",
      "capabilities": ["dms_neue_post", "dms_zu_erledigen", "dms_faellig_7_tage", "dms_ueberfaellig"],
      "platforms": ["local"],
      "connectivity": ["lan"],
      "images": {
        "small": "/drivers/dms/assets/images/small.png",
        "large": "/drivers/dms/assets/images/large.png",
        "xlarge": "/drivers/dms/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": { "en": "Connect Ablago", "de": "Ablago verbinden" },
            "usernameLabel": { "en": "Address of Ablago", "de": "Adresse von Ablago" },
            "usernamePlaceholder": { "en": "https://dms.home.arpa", "de": "https://dms.home.arpa" },
            "passwordLabel": { "en": "API key (level \"nur Zähler\", counts only)", "de": "API-Schlüssel (Stufe „nur Zähler“)" },
            "passwordPlaceholder": { "en": "dms_…", "de": "dms_…" }
          },
          "navigation": { "next": "list_devices" }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": { "next": "add_devices" }
        },
        { "id": "add_devices", "template": "add_devices" }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": { "en": "Connect Ablago again", "de": "Ablago neu verbinden" },
            "usernameLabel": { "en": "Address of Ablago", "de": "Adresse von Ablago" },
            "usernamePlaceholder": { "en": "https://dms.home.arpa", "de": "https://dms.home.arpa" },
            "passwordLabel": { "en": "API key (level \"nur Zähler\", counts only)", "de": "API-Schlüssel (Stufe „nur Zähler“)" },
            "passwordPlaceholder": { "en": "dms_…", "de": "dms_…" }
          }
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": { "en": "Connection", "de": "Verbindung" },
          "children": [
            {
              "id": "adresse",
              "type": "text",
              "label": { "en": "Address of Ablago", "de": "Adresse von Ablago" },
              "value": "",
              "hint": {
                "en": "For example https://dms.home.arpa or http://192.0.2.10:8080. Homey must reach this address on your home network.",
                "de": "Zum Beispiel https://dms.home.arpa oder http://192.0.2.10:8080. Homey muss die Adresse im Heimnetz erreichen."
              }
            },
            {
              "id": "schluessel",
              "type": "password",
              "label": { "en": "API key", "de": "API-Schlüssel" },
              "value": "",
              "hint": {
                "en": "Create it in Ablago: click your name at the top right → \"Mein Konto\" (my account) → \"Sicherheit\" (security) → \"API-Schlüssel\" (API keys), with the level \"nur Zähler\" (counts only). The key only reads numbers, no titles or content.",
                "de": "Leg ihn in Ablago an: Klick oben rechts auf deinen Namen → Mein Konto → Sicherheit → API-Schlüssel, Stufe „nur Zähler“. Der Schlüssel liest nur Zahlen, keine Titel oder Inhalte."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": { "en": "Polling", "de": "Abfrage" },
          "children": [
            {
              "id": "intervall",
              "type": "number",
              "label": { "en": "Polling interval", "de": "Abfrage-Abstand" },
              "value": 5,
              "min": 1,
              "max": 1440,
              "units": { "en": "min", "de": "Min." },
              "hint": {
                "en": "How often Homey asks Ablago. If nothing has changed, Ablago only answers \"not modified\" (304).",
                "de": "Wie oft Homey bei Ablago nachfragt. Hat sich nichts geändert, antwortet Ablago nur mit „nichts Neues“ (304)."
              }
            }
          ]
        }
      ]
    }
  ],
  "flow": {
    "triggers": [
      {
        "id": "neue_post",
        "title": { "en": "New mail arrived", "de": "Neue Post angekommen" },
        "hint": {
          "en": "Fires when the number of new mail in Ablago goes up, at the latest after one polling interval.",
          "de": "Löst aus, sobald die Zahl der neuen Post in Ablago steigt – spätestens nach einem Abfrage-Abstand."
        },
        "tokens": [
          {
            "name": "neue_post",
            "type": "number",
            "title": { "en": "New mail in total", "de": "Neue Post insgesamt" },
            "example": 3
          },
          {
            "name": "dazu",
            "type": "number",
            "title": { "en": "Newly arrived", "de": "Neu dazugekommen" },
            "example": 1
          }
        ],
        "args": [
          { "type": "device", "name": "device", "filter": "driver_id=dms" }
        ]
      },
      {
        "id": "bald_faellig",
        "title": { "en": "Something is due soon or overdue", "de": "Etwas wird bald fällig oder ist überfällig" },
        "titleFormatted": { "en": "Something [[art]]", "de": "Etwas [[art]]" },
        "hint": {
          "en": "Fires when the number \"Due in 7 days\" or \"Overdue\" goes up – also when someone adds a new deadline, reminder or task with a date in the next 7 days.",
          "de": "Löst aus, wenn die Zahl „Fällig in 7 Tagen“ oder „Überfällig“ steigt – auch, wenn jemand eine neue Frist, Erinnerung oder Aufgabe mit Datum in den nächsten 7 Tagen anlegt."
        },
        "tokens": [
          {
            "name": "faellig_7_tage",
            "type": "number",
            "title": { "en": "Due in 7 days", "de": "Fällig in 7 Tagen" },
            "example": 2
          },
          {
            "name": "ueberfaellig",
            "type": "number",
            "title": { "en": "Overdue", "de": "Überfällig" },
            "example": 1
          }
        ],
        "args": [
          { "type": "device", "name": "device", "filter": "driver_id=dms" },
          {
            "type": "dropdown",
            "name": "art",
            "title": { "en": "When", "de": "Wann" },
            "values": [
              {
                "id": "anstehend",
                "label": { "en": "is due soon (within 7 days)", "de": "wird bald fällig (in 7 Tagen)" }
              },
              {
                "id": "ueberfaellig",
                "label": { "en": "is overdue", "de": "ist überfällig" }
              }
            ]
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "neue_post_vorhanden",
        "title": { "en": "There !{{is|is no}} new mail", "de": "Es liegt !{{neue|keine neue}} Post vor" },
        "hint": { "en": "Checks the last value Homey received from Ablago.", "de": "Prüft den letzten Wert, den Homey von Ablago bekommen hat." },
        "args": [
          { "type": "device", "name": "device", "filter": "driver_id=dms" }
        ]
      }
    ]
  }
}
